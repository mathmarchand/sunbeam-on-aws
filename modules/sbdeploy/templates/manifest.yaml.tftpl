# Sunbeam deployment manifest for the MAAS lab (generated by Terraform).
#
# On sbdeploy:
#   sunbeam cluster bootstrap --manifest ~/manifest.yaml
#   sunbeam cluster deploy
#   sunbeam configure --openrc ~/demo-openrc
#
# In MAAS mode, machine roles, the Ceph disks and the provider NIC come from
# MAAS tags (control/compute/storage, ceph, ${physnet_tag}); only the
# answers to the interactive questions live here.
core:
  config:
    proxy:
      proxy_required: false

    # "single": one MySQL cluster shared by all services (lighter, fits the lab).
    # "multi": one MySQL cluster per service.
    database: ${database}

    region: ${region}

    # The external (provider) network is the lab L2 segment itself, reached
    # through the 2nd NIC of sb1-3 (tagged ${physnet_tag}). The allocation pool is
    # the range reserved in MAAS as "openstack-floating-ips".
    external_network:
      cidr: ${lab_cidr}
      gateway: ${lab_gateway}
      range: ${floating_start}-${floating_end}
      network_type: flat

    # Demo tenant created by "sunbeam configure".
    user:
      run_demo_setup: true
      username: ${demo_username}
      password: ${jsonencode(demo_password)}
      cidr: ${demo_cidr}
      nameservers: ${demo_nameservers}
      security_group_rules: true
      remote_access_location: remote
